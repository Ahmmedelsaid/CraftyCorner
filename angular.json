{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer": {
      "projectType": "application",
      "schematics": {},
      "root": "customer",
      "sourceRoot": "customer/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "customer/src/main.ts",
            "allowedCommonJsDependencies": [
              "leaflet"
            ],
            "tsConfig": "customer/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "shared/public"
              }
            ],
            "styles": [
              "customer/src/styles.css"
            ],
            "index": "customer/src/index.html",
            "outputPath": "dist/customer"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "shared/environments/environment.ts",
                  "with": "shared/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "customer:build:production"
            },
            "development": {
              "buildTarget": "customer:build:development"
            }
          },
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4200
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "customer/tsconfig.spec.json"
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {},
      "root": "admin",
      "sourceRoot": "admin/src",
      "prefix": "admin",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "admin/src/main.ts",
            "allowedCommonJsDependencies": [
              "leaflet"
            ],
            "tsConfig": "admin/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "shared/public"
              }
            ],
            "styles": [
              "admin/src/styles.css"
            ],
            "index": "admin/src/index.html",
            "outputPath": "dist/admin"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "shared/environments/environment.ts",
                  "with": "shared/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin:build:production"
            },
            "development": {
              "buildTarget": "admin:build:development"
            }
          },
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4201
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "admin/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
